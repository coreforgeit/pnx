FROM python:3.12.8

# Устанавливаем зависимости
WORKDIR /app
COPY /requirements/web.txt /app/web.txt

RUN pip install --upgrade pip && pip install --no-cache-dir -r web.txt

COPY /web .

EXPOSE 8000

CMD ["sh", "-c", "python manage.py migrate --noinput && gunicorn web.wsgi:application --bind 0.0.0.0:8000 --workers ${GUNICORN_WORKERS:-1}"]


